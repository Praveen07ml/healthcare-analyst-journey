<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="Practice_Joins_DB.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1891"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="customers" custom_title="0" dock_id="1" table="4,9:maincustomers"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- Display customers who have placed at least one order

SELECT c.customer_name
FROM customers c
where EXISTS (select 1 FROM orders o where o.customer_id = c.customer_id);



SELECT customer_name
FROM customers
WHERE customer_id in (SELECT customer_id FROM orders);


SELECT c.customer_name,count(o.order_id) as order_count
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
GROUP by c.customer_name 
HAVING count(o.order_id) &gt;= 1;



-- Display customers who have never placed an order.

-- Use NOT EXISTS.

-- Expected:

-- customer_name
-- city


SELECT customer_name,city
from customers c
WHERE not EXISTS (SELECT 1 FROM orders o where o.customer_id = c.customer_id);


-- Display products that have been sold.

-- Use EXISTS.


-- product_name
-- category


SELECT product_name,category
FROM products p
WHERE EXISTS (SELECT 1 FROM orders o WHERE o.product_id = p.product_id);


-- Display products that have never been sold.

-- Use NOT EXISTS.



-- product_name
-- category


SELECT product_name,category
FROM products p
WHERE not EXISTS (SELECT 1 FROM orders o where o.product_id=p.product_id);



-- Display customers who purchased Electronics products.



-- customer_name

SELECT customer_name
FROM customers c
where EXISTS (SELECT 1 FROM orders o JOIN products p on o.product_id = p.product_id where  o.customer_id = c.customer_id and p.category = &quot;Electronics&quot;);


-- Display customers who purchased a Laptop.



-- customer_name 

SELECT customer_name
FROM customers c
WHERE EXISTS (SELECT 1 FROM orders o join products p on o.product_id = p.product_id
              where o.customer_id = c.customer_id and p.product_name like &quot;Lap%&quot;);
			  
			  
-- Display products purchased by customers from Hyderabad.

SELECT product_name
FROM products p 
where EXISTS (SELECT 1 
              FROM orders o
			  JOIN customers c on o.customer_id = c.customer_id
			 WHERE o.product_id = p.product_id and c.city = &quot;Hyderabad&quot;); 
			 
			 
			 
-- Display customers who have purchased more than one product.

-- customer_name

-- Hint: Count the rows inside the correlated subquery.

SELECT customer_name
FROM customers c
WHERE (SELECT count(o.order_id) FROM orders o where o.customer_id = c.customer_id) &gt;= 1;


</sql><current_tab id="0"/></tab_sql></sqlb_project>
