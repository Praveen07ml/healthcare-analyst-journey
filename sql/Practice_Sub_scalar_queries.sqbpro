index="1" value="74"/><column index="2" value="96"/><column index="3" value="93"/><column index="4" value="46"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- Display all products whose price is greater than the average price.


-- product_name
-- price


SELECT product_name,price
FROM products
WHERE price &gt; (SELECT avg(price) FROM products);



-- Display all products whose price is less than the maximum price.

SELECT product_name,price
FROM products
WHERE price &lt; (SELECT max(price) FROM products);



-- Display all products whose price is equal to the minimum price.

SELECT product_name,price
FROM products
WHERE price = ( SELECT min(price) FROM products);

-- Display the customers who purchased the Printer.

-- customer_name
-- city


SELECT customer_name,city
FROM customers
WHERE customer_id in (SELECT c.customer_id
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id
WHERE p.product_name = &quot;Printer&quot;);


-- Display customers who have placed at least one order.

-- Expected columns:

-- customer_name
-- city


SELECT customer_name,city
FROM customers
WHERE customer_id in (SELECT customer_id
                      FROM orders);
					  
					  
					  
-- Display customers who have never placed an order.

SELECT customer_name,city
FROM customers
WHERE customer_id not in (SELECT customer_id FROM orders);



-- Display customers who purchased Electronics products.


SELECT customer_name,city
FROM customers
WHERE customer_id in (SELECT c.customer_id
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id
WHERE p.category like  &quot;Ele%&quot;);


-- Display products whose price is greater than the average price of Electronics products.


SELECT product_name,price
FROM products
WHERE price &gt; (SELECT avg(price)
FROM products
WHERE category like &quot;Ele%&quot;);


-- Display customers who purchased the most expensive product.

SELECT c.customer_name,c.city
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id
WHERE p.price = (SELECT max(price) FROM products);


-- Display customers whose total spending is greater than the average order amount.


SELECT c.customer_name,sum(o.quantity*p.price-o.discount) as total_spend
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id
GROUP by c.customer_name
HAVING sum(o.quantity*p.price-o.discount) &gt; (SELECT avg(o.quantity*p.price-o.discount)
                                             from products p
											 JOIN orders o
											 on o.product_id = p.product_id);</sql><current_tab id="0"/></tab_sql></sqlb_project>
