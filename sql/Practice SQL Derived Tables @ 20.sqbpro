<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="SQL Interview Practice.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1661"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="categories" custom_title="0" dock_id="1" table="4,10:maincategories"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- Display the names of customers whose total spending is greater than the average total spending of all customers.


SELECT t.customer_name
FROM (SELECT c.customer_name,sum(total_amount) as total_spend
      FROM customers c
	  JOIN orders  o on o.customer_id = c.customer_id
	  GROUP by c.customer_id,c.customer_name) t
WHERE t.total_spend &gt; (SELECT avg(p.total_spend)
                     FROM (SELECT sum(total_amount) as total_spend
      FROM customers c
	  JOIN orders  o on o.customer_id = c.customer_id
	  GROUP by c.customer_id,c.customer_name)p);
	  
	  
-- Display the names of customers who have placed the maximum number of orders.


SELECT t1.customer_name
FROM (SELECT c.customer_name,count(o.order_id) as order_count
      FROM customers c
	  JOIN orders o
	  on c.customer_id = o.customer_id
	  GROUP by c.customer_id,c.customer_name) t1
WHERE t1.order_count = (SELECT max(t2.order_count)
                     from (SELECT c1.customer_name,count(o1.order_id) as order_count
					       FROM customers c1
	                       JOIN orders o1
	                       on c1.customer_id = o1.customer_id
	                       GROUP by c1.customer_id,c1.customer_name)t2);
						   
						   
-- Display the names of customers whose latest order amount is less than their own average order amount.


SELECT t.customer_name
FROM (SELECT c.customer_id,c.customer_name,o.total_amount as latest_order_amount
      from customers c
	  join orders o 
	  on c.customer_id = o.customer_id
	  WHERE o.order_date = (SELECT max(o1.order_date)
	                        from orders o1
							WHERE o1.customer_id = c.customer_id)) t
WHERE t.latest_order_amount &lt; (SELECT avg(o2.total_amount)
                             FROM orders o2
							 WHERE o2.customer_id = t.customer_id)
							 
							</sql><current_tab id="0"/></tab_sql></sqlb_project>
