ex="1" value="74"/><column index="2" value="96"/><column index="3" value="93"/><column index="4" value="46"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- Question 1 ⭐

-- Display:

-- Order ID
-- Customer Name
-- City


SELECT o.order_id,c.customer_name,c.city
FROM orders o
JOIN customers c
on o.customer_id = c.customer_id;


-- Display:

-- Order ID
-- Product Name
-- Price

SELECT o.order_id,p.product_name,p.price
FROM orders o
JOIN products p
on o.product_id = p.product_id;


-- Question 3

-- Display:

-- Customer Name
-- Product Name
-- Quantity

SELECT c.customer_name,p.product_name,o.quantity
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id;


-- Display:

-- Customer Name
-- Product Name
-- Price
-- Discount

SELECT c.customer_name,p.product_name,p.price,o.discount
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id;


-- Display all orders placed by customers from Hyderabad.

-- Customer Name
-- City
-- Product Name
-- Quantity


SELECT c.customer_name,c.city,p.product_name,o.quantity
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id
WHERE c.city = &quot;Hyderabad&quot;;



-- Display all Electronics purchases.

-- Customer Name
-- Product Name
-- Category
-- Price

SELECT c.customer_name,p.product_name,p.category,p.price
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id
WHERE p.category like &quot;Ele%&quot;;


-- Display all orders where the price is greater than ₹10,000.

-- Customer Name
-- Product Name
-- Price

SELECT c.customer_name,p.product_name,p.price
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id
WHERE p.price &gt; 10000;


-- Find the total amount of each order.

-- Order ID
-- Customer Name
-- Product Name
-- Total Amount


SELECT o.order_id,c.customer_name,p.product_name,sum(o.quantity*p.price - o.discount) as total_amount
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id
group by o.order_id,c.customer_name,p.product_name;


-- Find all customers who bought a Laptop.

-- Customer Name
-- City

SELECT c.customer_name,c.city
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id
where p.product_name = &quot;Laptop&quot;;


-- Customer Name
-- Product Name
-- Category
-- Quantity
-- Price
-- Discount
-- Total Amount


SELECT c.customer_name,p.product_name,p.category,o.quantity,p.price,o.discount,sum(o.quantity*p.price-o.discount) as total_amount
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id
GROUP by c.customer_name,p.product_name,p.category,o.quantity,p.price,o.discount
ORDER by total_amount desc;



-- Display all customers, along with their order IDs.

-- customer_name
-- city
-- order_id

-- Customers without orders should also appear.


SELECT c.customer_name,c.city,o.order_id
FROM customers c
LEFT JOIN orders o 
on o.customer_id = c.customer_id;


-- Display all products along with their order IDs.

SELECT p.product_name,p.category,o.order_id
FROM products p
LEFT JOIN orders o
on o.product_id = p.product_id;


-- Find customers who never placed an order.

SELECT c.customer_name,c.city
FROM customers c
LEFT JOIN orders o
on o.customer_id = c.customer_id
WHERE o.order_id is Null;

-- Find products that have never been sold.

SELECT p.product_name,p.category
FROM products p
LEFT JOIN orders o
on o.product_id = p.product_id
where o.order_id is NULL;


-- Display all customers and the products they bought.

-- customer_name
-- product_name

SELECT c.customer_name,p.product_name
FROM customers c
LEFT JOIN orders o on o.customer_id = c.customer_id
LEFT JOIN products p on o.product_id = p.product_id;


-- Display all customers with their total number of orders.

SELECT c.customer_name,count(o.order_id) as total_orders
FROM customers c
left JOIN orders o
on o.customer_id = c.customer_id
GROUP by c.customer_name
order by total_orders desc;


-- Display all products with the total quantity sold.
SELECT p.product_name,coalesce(sum(o.quantity),0) as total_quantity
FROM products p
LEFT JOIN orders o
on o.product_id = p.product_id
group by p.product_name;


-- Find cities that have customers who never placed any order.

SELECT c.city, c.customer_name
FROM customers c
left JOIN orders o
on o.customer_id = c.customer_id
WHERE o.order_id is NULL;



-- Display all customers, their product names, and total amount.


SELECT c.customer_name,p.product_name,(o.quantity*p.price-o.discount) as total_amount
FROM customers c
LEFT JOIN orders o on o.customer_id = c.customer_id
LEFT JOIN products p on o.product_id = p.product_id;





SELECT c.customer_name,c.city,count(o.order_id) as order_count,sum(o.quantity*p.price-o.discount) as total_amount
FROM customers c
LEFT JOIN orders o on o.customer_id = c.customer_id
LEFT JOIN products p on o.product_id = p.product_id
GROUP by c.customer_name,c.city;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
