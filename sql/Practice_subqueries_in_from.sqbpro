<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="Practice_Joins_DB.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1891"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="customers" custom_title="0" dock_id="1" table="4,9:maincustomers"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- Question 1 ⭐
--Create a temporary table that shows each customer's total spending.
---Then display:
---customer_name
---total_spending
---Formula:
---(quantity × price) - discount

SELECT customer_name,total_spending
FROM ( SELECT c.customer_name,sum(o.quantity*p.price-o.discount) as total_spending
        FROM customers c
		JOIN orders o
		on o.customer_id = c.customer_id
		JOIN products p on o.product_id = p.product_id
		GROUP by c.customer_name) as t;
		
		
-- Question 2
-- Using a derived table, display customers whose total spending is greater than ₹50,000.
-- Expected columns:
-- customer_name
-- total_spending

SELECT customer_name,total_spending
FROM ( SELECT c.customer_name,sum(o.quantity*p.price-o.discount) as total_spending
        FROM customers c
		JOIN orders o
		on o.customer_id = c.customer_id
		JOIN products p on o.product_id = p.product_id
		GROUP by c.customer_name) as t
WHERE t.total_spending &gt; 50000;



-- Question 3
---Create a temporary table showing the total quantity sold for each product.
---hen display:
---product_name
---total_quantity



SELECT product_name,total_quantity
FROM (SELECT product_name,count(order_id) as total_quantity
      FROM products p
	  JOIN orders o on o.product_id = p.product_id 
	  GROUP by product_name) t;
	  
	  
-- Question 4
-- Using the result from Question 3, display products whose total quantity sold is greater than 2.
-- Expected columns:
-- product_name
-- total_quantity

SELECT product_name,total_quantity
FROM (SELECT product_name,count(order_id) as total_quantity
      FROM products p
	  JOIN orders o on o.product_id = p.product_id 
	  GROUP by product_name) t
WHERE t.total_quantity &gt; 2;



-- Question 5 ⭐
-- Create a temporary table showing total revenue by city.
-- Revenue formula:
-- (quantity × price) - discount
-- Then display:
-- city
-- total_revenue


SELECT city,total_revenue
FROM (SELECT c.city,sum(o.quantity*p.price-o.discount) as total_revenue
      FROM customers c
	  join 	orders o on o.customer_id = c.customer_id
	  JOIN products p on o.product_id = p.product_id
	  GROUP by c.city) t;
	  
	  
-- Question 6
--Using the temporary table from Question 5, display cities whose revenue is greater than ₹100,000.
-- Expected columns:
--city
--total_revenue

SELECT city,total_revenue
FROM (SELECT c.city,sum(o.quantity*p.price-o.discount) as total_revenue
      FROM customers c
	  join 	orders o on o.customer_id = c.customer_id
	  JOIN products p on o.product_id = p.product_id
	  GROUP by c.city) t
where t.total_revenue &gt; 100000;



-- Question 7 ⭐⭐
--- Create a temporary table showing:
-- category
-- average_price
-- Then display:
-- category
-- average_price


SELECT category,avg_price
FROM (SELECT category,avg(price) as avg_price
      FROM products 
	  GROUP by category) t;
	  
	  
-- Question 8
-- Using Question 7's derived table, display categories where the average price is greater than ₹10,000.
-- Expected columns:
-- category
-- average_price


SELECT category,avg_price
FROM (SELECT category,avg(price) as avg_price
      FROM products 
	  GROUP by category) t
WHERE t.avg_price &gt; 10000;



-- Question 9 ⭐⭐⭐
--Create a temporary table showing:
--customer_name
--total_orders
--Then display customers having more than one order.
--Expected columns:
--customer_name
-- total_orders


SELECT customer_name,order_count
FROM ( SELECT c.customer_name,count(o.order_id) as order_count
      FROM customers c
	  JOIN orders o
	  on o.customer_id = c.customer_id
	  GROUP by c.customer_name) t;
	  
	  
-- Question 10 ⭐⭐⭐⭐ (Real Interview)
-- Create a temporary table showing:
-- customer_name
-- total_spending
-- Then calculate the average customer spending from that temporary table.
-- Expected output:
-- average_customer_spending


SELECT avg_total_spending
from (SELECT avg(total_spending) as avg_total_spending FROM (SELECT c.customer_name,sum(o.quantity*p.price-o.discount) as total_spending
                                       from customers c JOIN orders o on o.customer_id = c.customer_id
									   JOIN products p on o.product_id = p.product_id
									   GROUP by customer_name));</sql><current_tab id="0"/></tab_sql></sqlb_project>
