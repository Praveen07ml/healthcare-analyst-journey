ue="59"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="orders" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="60"/><column index="2" value="86"/><column index="3" value="85"/><column index="4" value="91"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="products" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="74"/><column index="2" value="117"/><column index="3" value="82"/><column index="4" value="62"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- Display the names of customers who have placed exactly one order.


SELECT c.customer_name
FROM customers c
JOIN orders o
on o.customer_id = c.customer_id
GROUP by c.customer_id,c.customer_name
HAVING count(o.order_id) = 1;


-- Display the names of customers who have placed more than 3 orders and whose average order amount is greater than ₹2,000.


SELECT c.customer_name
FROM customers c
JOIN orders o
on o.customer_id = c.customer_id
GROUP by c.customer_id,c.customer_name
HAVING count(o.order_id) &gt; 3 and avg(o.total_amount) &gt; 2000;


-- Display the names of customers who have never purchased any Electronics product.


SELECT c.customer_name
FROM customers c
WHERE NOT EXISTS (SELECT 1
                  FROM orders o 
				  JOIN order_items o1 on o1.order_id = o.order_id
				  JOIN products p on p.product_id = o1.product_id
				  JOIN categories cat on cat.category_id = p.category_id
				  WHERE o.customer_id = c.customer_id and cat.category_name = 'Electronics');
				  

-- Display the names of customers who have purchased only Footwear products.

SELECT c.customer_name
FROM customers c
WHERE NOT EXISTS (SELECT 1
                  FROM orders o
				  JOIN order_items o1 on o1.order_id = o.order_id
				  JOIN products p on p.product_id = o1.product_id
				  JOIN categories cat on cat.category_id = p.category_id
				  WHERE o.customer_id = c.customer_id and cat.category_name &lt;&gt; 'Footwear'); 
				  
				  
-- Display the names of customers whose latest order was placed after February 15, 2025.


SELECT c.customer_name
FROM customers c
JOIN orders o
on o.customer_id = c.customer_id
GROUP by c.customer_id,c.customer_name
HAVING max(o.order_date) &gt; '2025-02-15';



-- Display the names of customers who have purchased exactly 5 different products.


SELECT c.customer_name
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN order_items o1 on o1.order_id = o.order_id
GROUP by  c.customer_id,c.customer_name
HAVING count(DISTINCT o1.product_id) = 5;



-- Display the names of customers who have purchased every Footwear product.

SELECT c.customer_name
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN order_items o1 on o1.order_id = o.order_id
JOIN products p on p.product_id = o1.product_id
JOIN categories cat on cat.category_id = p.category_id
WHERE cat.category_name = 'Footwear'
GROUP by  c.customer_id, c.customer_name
HAVING count(DISTINCT p.product_id) = (SELECT count(p.product_id)
                                        FROM products p 
										JOIN categories c on c.category_id = p.category_id
										WHERE c.category_name = 'Footwear');
										
										
-- Display the names of customers who have placed at least one order above ₹10,000 and never placed an order below ₹1,000.


SELECT c.customer_name
FROM customers c
WHERE EXISTS (SELECT 1
              FROM orders o
			  where o.customer_id = c.customer_id and o.total_amount &gt; 10000) and NOT EXISTS (SELECT 1
			                                                                                  FROM orders o1
																							  WHERE o1.customer_id = c.customer_id AND
																							  o1.total_amount &lt; 1000 );
																							  
																							  
																							  
-- Display the names of customers whose total spending is greater than ₹20,000 but whose average order amount is less than ₹5,000.


SELECT c.customer_name
FROM customers c
JOIN orders o
on o.customer_id = c.customer_id
GROUP by c.customer_id,c.customer_name
HAVING sum(o.total_amount) &gt; 20000 and avg(o.total_amount) &lt; 5000;

-- Display the names of customers who have purchased at least one product from every category and whose total purchased quantity is greater than 20 items

SELECT c.customer_name
FROM customers c
WHERE EXISTS (SELECT 1
              FROM orders o
			  JOIN order_items o1 on o1.order_id = o.order_id
			  JOIN products p on p.product_id = o1.product_id
			  WHERE o.customer_id = c.customer_id
			  GROUP by o.customer_id
			  HAVING (count(DISTINCT p.category_id) = (SELECT count(category_id)
			                                          FROM categories)) and sum(o1.quantity) &gt; 20);
													  
													  
													  

			  </sql><current_tab id="0"/></tab_sql></sqlb_project>
