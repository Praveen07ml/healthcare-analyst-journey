<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="SQL Interview Practice.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1661"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="order_items" custom_title="0" dock_id="1" table="4,11:mainorder_items"/><dock_state state="000000ff00000000fd0000000100000002000005f4000002acfc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000005f40000012500ffffff0000026c0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="categories" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="80"/><column index="2" value="124"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="customers" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="84"/><column index="2" value="106"/><column index="3" value="78"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="order_items" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="95"/><column index="2" value="62"/><column index="3" value="76"/><column index="4" value="59"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="orders" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="60"/><column index="2" value="86"/><column index="3" value="85"/><column index="4" value="91"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="products" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="74"/><column index="2" value="117"/><column index="3" value="82"/><column index="4" value="62"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- Display the names of customers who have purchased products from exactly 2 different categories.

SELECT c.customer_name
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN order_items o1 on o1.order_id = o.order_id
JOIN products p on p.product_id = o1.product_id
GROUP by c.customer_id,c.customer_name
HAVING count(DISTINCT p.category_id) = 2;



-- Display the names of customers who have placed more than 5 orders but whose total spending is less than ₹15,000.



SELECT c.customer_name
FROM customers c
JOIN orders o
on c.customer_id = o.customer_id
GROUP by c.customer_id,c.customer_name
HAVING count(o.order_id) &gt; 5 and sum(o.total_amount) &lt; 15000;


-- Display the names of customers who have never placed an order after January 31, 2025.


SELECT c.customer_name
FROM customers c
WHERE NOT EXISTS (SELECT 1 FROM orders o WHERE o.customer_id = c.customer_id and o.order_date &gt; '2025-01-31');



-- Display the names of customers who have purchased only Mobile products.


SELECT c.customer_name
FROM customers c
WHERE NOT EXISTS (SELECT 1
                  FROM orders o
				  JOIN order_items o1 on o1.order_id = o.order_id
                  JOIN products p on p.product_id = o1.product_id
                  JOIN categories cat on cat.category_id = p.category_id
				  WHERE o.customer_id = c.customer_id and cat.category_name &lt;&gt; 'Mobile');
				  
				  
				  
-- Display the names of customers who have purchased at least one product from every category.

SELECT c.customer_name
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN order_items o1 on o1.order_id = o.order_id
JOIN products p on p.product_id = o1.product_id
JOIN categories cat on cat.category_id = p.category_id
GROUP by c.customer_name
HAVING count(DISTINCT p.category_id) = (SELECT count(*) from categories );


-- Display the names of customers whose average order amount is greater than ₹5,000.


SELECT c.customer_name
FROM customers c
JOIN orders o
on o.customer_id = c.customer_id
GROUP by c.customer_id,c.customer_name
HAVING avg(o.total_amount) &gt; 5000;


-- Display the names of customers who have placed at least one order in January 2025 and at least one order in February 2025.


SELECT c.customer_name
from customers c
WHERE EXISTS (SELECT 1 FROM orders o where o.customer_id = c.customer_id and o.order_date BETWEEN '2025-01-01' and '2025-01-31') AND EXISTS
             (SELECT 1 FROM orders o where o.customer_id = c.customer_id and o.order_date BETWEEN '2025-02-01' and '2025-02-28');
			 
-- Display the names of customers who have placed their first order before January 15, 2025.


SELECT c.customer_name
FROM customers c
JOIN orders o
on o.customer_id = c.customer_id
GROUP by c.customer_id,c.customer_name
HAVING min(o.order_date) &lt; '2025-01-15';


-- Display the names of customers who have purchased more than 10 items (counting quantity purchased, not distinct products)

SELECT c.customer_name
FROM customers c
JOIN orders o
on c.customer_id = o.customer_id
JOIN order_items o1 on o1.order_id = o.order_id
GROUP by c.customer_id,c.customer_name
HAVING sum(o1.quantity) &gt; 10;



-- Display the names of customers who have purchased every Electronics product and have never purchased a Footwear product.


SELECT c.customer_name
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN order_items o1 on o1.order_id = o.order_id
JOIN products p on p.product_id = o1.product_id
JOIN categories cat on cat.category_id = p.category_id
where cat.category_name = 'Electronics' 
GROUP by c.customer_id,c.customer_name
HAVING count(DISTINCT p.product_id) = (SELECT count(p.product_id) FROM products p join categories c on c.category_id = p.category_id
                                       where cat.category_name = 'Electronics') and not EXISTS 
									   (SELECT 1
									   from orders o
									   JOIN order_items o1 on o1.order_id = o.order_id
                                       JOIN products p on p.product_id = o1.product_id
                                       JOIN categories cat on cat.category_id = p.category_id
									   where o.customer_id = c.customer_id and cat.category_name = 'Footwear');</sql><current_tab id="0"/></tab_sql></sqlb_project>
