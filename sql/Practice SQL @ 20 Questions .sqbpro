<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="SQL Interview Practice.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1661"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="orders" custom_title="0" dock_id="1" table="4,6:mainorders"/><dock_state state="000000ff00000000fd0000000100000002000005f4000002acfc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000005f40000012500ffffff0000026c0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="categories" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="80"/><column index="2" value="124"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="customers" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="84"/><column index="2" value="106"/><column index="3" value="78"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="order_items" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="95"/><column index="2" value="62"/><column index="3" value="76"/><column index="4" value="59"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="orders" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="60"/><column index="2" value="86"/><column index="3" value="85"/><column index="4" value="91"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="products" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="74"/><column index="2" value="117"/><column index="3" value="82"/><column index="4" value="62"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- Display the names of customers who have placed at least one order.

SELECT DISTINCT c.customer_name
FROM customers c
JOIN orders o
on o.customer_id = c.customer_id
WHERE EXISTS (SELECT 1
              FROM orders o1
			  where	o1.customer_id = c.customer_id) ;

			  
			  
-- Display the names of customers who have never placed an order.


SELECT c.customer_name
FROM customers c
WHERE not EXISTS (SELECT 1
                  FROM orders o
				  WHERE o.customer_id = c.customer_id);
				  
-- Display the names of customers who have placed exactly 2 orders.

SELECT c.customer_name,count(o.order_id) as order_count
FROM customers c
JOIN orders o
on o.customer_id = c.customer_id
GROUP by c.customer_name
HAVING count(o.order_id) = 2;


-- Display the names of customers who have placed at least 2 orders, and every order is worth more than ₹1,000.


SELECT c.customer_name,count(o.order_id) as order_count
FROM customers c
JOIN orders o
on c.customer_id = o.customer_id
WHERE not EXISTS (SELECT 1
              FROM orders o1
			  WHERE o1.customer_id = o.customer_id and o1.total_amount &gt;= 1000)
GROUP by c.customer_id,c.customer_name
HAVING count(o.order_id) &gt;=2;




-- Display the names of customers who have never placed an order worth more than ₹5,000.


SELECT c.customer_name,o.total_amount
FROM customers c
JOIN orders o
on c.customer_id = o.customer_id
WHERE not EXISTS (SELECT 1 FROM orders o1 WHERE o1.customer_id = c.customer_id and o1.total_amount &gt;= 5000);



-- Display the names of customers who have placed at least one order worth more than ₹5,000.

SELECT c.customer_name
from customers c 
WHERE EXISTS (SELECT 1 FROM orders o WHERE o.customer_id = c.customer_id and o.total_amount &gt;= 5000);


-- Display the names of customers who have placed exactly 3 orders.

SELECT c.customer_name,count(o.order_id) as order_count
FROM customers c
JOIN orders o
on o.customer_id = c.customer_id
GROUP by c.customer_id,c.customer_name
HAVING count(o.order_id) = 3;


-- Display the names of customers who have placed at least 5 orders


SELECT c.customer_name,count(o.order_id) as order_count
FROM customers c
JOIN orders o
on o.customer_id = c.customer_id
GROUP by c.customer_id,c.customer_name
HAVING count(o.order_id) &gt;= 5;



-- Display the names of customers who have purchased products from at least 2 different categories.

SELECT c.customer_name,count( DISTINCT p.category_id) as category_count
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN order_items o1 on o1.order_id = o.order_id
JOIN products p on p.product_id = o1.product_id
GROUP by c.customer_id,c.customer_name
HAVING count(DISTINCT p.category_id) &gt;=2;



-- Display the names of customers who have purchased only Electronics products.





SELECT DISTINCT c.customer_name
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN order_items o1 on  o1.order_id = o.order_id
JOIN products p on p.product_id = o1.product_id
JOIN categories cat on cat.category_id = p.category_id
WHERE not EXISTS (SELECT 1 FROM  orders o1 
JOIN order_items o2 on  o2.order_id = o1.order_id
JOIN products p1 on p1.product_id = o2.product_id
JOIN categories cat1 on cat1.category_id = p1.category_id WHERE o1.customer_id = c.customer_id and cat1.category_name &lt;&gt; 'Electronics');


-- Display the names of customers who have purchased products from exactly 3 different categories.



SELECT c.customer_name
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN order_items o1 on o1.order_id = o.order_id
JOIN products p on p.product_id = o1.product_id
GROUP by c.customer_id,c.customer_name
HAVING count(DISTINCT p.category_id) = 3;


-- Display the names of customers whose every order is worth at least ₹2,000.


SELECT c.customer_name
FROM customers c
WHERE not EXISTS (SELECT 1 FROM orders o WHERE o.customer_id = c.customer_id and o.total_amount &lt; 2000);



-- Display the names of customers who have purchased at least one product from the Mobile category.


SELECT c.customer_name
FROM customers c
WHERE EXISTS (SELECT 1 
              FROM orders o
			  JOIN order_items od on od.order_id = o.order_id
			  JOIN products p on p.product_id = od.product_id
			  JOIN categories c on c.category_id = p.category_id
			  WHERE o.customer_id = c.customer_id and c.category_name = 'Mobile');
			  
			  
			  
-- Display the names of customers who have never purchased a product from the Footwear category.


SELECT c.customer_name
FROM customers c
WHERE not exists (SELECT 1
                  FROM orders o
				  JOIN order_items o1 on o1.order_id = o.order_id
				  JOIN products p on p.product_id = o1.product_id
				  JOIN categories c on c.category_id = p.category_id
				  WHERE o.customer_id = c.customer_id and c.category_name = 'Footwear');
				  
				  
-- Display the names of customers who have placed at least 3 orders and have never placed an order worth less than ₹1,000.


SELECT c.customer_name
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
WHERE NOT EXISTS (SELECT 1 FROM orders o1 WHERE o1.customer_id = c.customer_id and o1.total_amount &lt; 1000)
GROUP by c.customer_id,c.customer_name
HAVING count(o.order_id) &gt;= 3 ;


-- Display the names of customers whose total spending across all their orders is greater than ₹20,000.


SELECT t.customer_name,t.total_amount
FROM (SELECT c.customer_name,sum(o.total_amount) as total_amount
      FROM customers c 
	  JOIN orders o on o.customer_id = c.customer_id
	  GROUP by c.customer_id,c.customer_name) t
where t.total_amount &gt; 20000; 



-- Display the names of customers who have purchased more than 5 different products.

SELECT c.customer_name
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN order_items o1 on o1.order_id = o.order_id
GROUP by c.customer_id,c.customer_name
HAVING count(distinct o1.product_id) &gt;5;



-- Display the names of customers who have purchased at least one Electronics product and at least one Mobile product.


SELECT c.customer_name
FROM customers c
WHERE EXISTS (SELECT 1 FROM orders o
              join order_items o1 on o1.order_id = o.order_id
			  JOIN products p on p.product_id = o1.product_id
			  JOIN categories c on c.category_id = p.category_id
			  WHERE o.customer_id = c.customer_id and c.category_name = 'Electronics') and 
			  EXISTS (SELECT 1 FROM orders o
              join order_items o1 on o1.order_id = o.order_id
			  JOIN products p on p.product_id = o1.product_id
			  JOIN categories c on c.category_id = p.category_id
			  WHERE o.customer_id = c.customer_id and c.category_name = 'Mobile');
			  
			  
			  
-- Display the names of customers who have purchased every product in the Mobile category.



									   
									   
									   

SELECT c.customer_name,count(distinct p.product_id) as order_count
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
JOIN order_items o1 on o1.order_id = o.order_id
JOIN products p on p.product_id  = o1.product_id
JOIN categories c on c.category_id = p.category_id
WHERE c.category_name = 'Mobile'
GROUP by c.customer_id,c.customer_name
HAVING count(distinct p.product_id) = (SELECT count(p.product_id) FROM products p
                                       JOIN categories c on c.category_id = p.category_id
									   WHERE c.category_name = 'Mobile');
									   
									   
									   
-- Display the names of customers who have placed exactly 2 orders and whose total spending is greater than ₹10,000.


SELECT c.customer_name
FROM customers c
JOIN orders o on o.customer_id = c.customer_id
GROUP by c.customer_id,c.customer_name
HAVING (count(o.order_id) = 2) and (sum(o.total_amount) &gt; 10000);</sql><current_tab id="0"/></tab_sql></sqlb_project>
