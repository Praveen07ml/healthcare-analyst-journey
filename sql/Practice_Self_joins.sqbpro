<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="Practice_Self_joins.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1144"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="employees" custom_title="0" dock_id="1" table="4,9:mainemployees"/><dock_state state="000000ff00000000fd0000000100000002000005f4000002acfc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000005f40000012500ffffff0000026c0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="employees" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="86"/><column index="2" value="108"/><column index="3" value="132"/><column index="4" value="81"/><column index="5" value="85"/><column index="6" value="54"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- Display all employees who report directly to John.

SELECT e1.employee_name as Employee,e2.employee_name as Manager 
FROM employees e1
JOIN employees e2
on e1.manager_id = e2.employee_id
WHERE e2.employee_name = &quot;John&quot;;


-- Employee Name
-- Employee Department
-- Manager Department


SELECT e1.employee_name as Employee,e1.department as Employee_department,e2.department as manager_department
FROM employees e1
JOIN employees e2
on e1.manager_id = e2.employee_id;



-- Display employees whose salary is greater than their manager's salary.


SELECT e1.employee_name as Employee,e1.salary as Employee_Salary,e2.employee_name as manager,e2.salary as manager_salary
FROM employees e1
JOIN employees e2
on e1.manager_id = e2.employee_id and e1.salary &gt; e2.salary;


-- Display managers who supervise at least two employees.

SELECT e1.employee_name as Manager, count(e2.employee_name) as number_of_employees
FROM employees e1
JOIN employees e2
on e1.employee_id = e2.manager_id
GROUP by e1.employee_name
HAVING count(e2.employee_name) &gt;= 2;


-- Display employees who do not have a manager.

SELECT e1.employee_name as Employee,e2.employee_name as manager
FROM employees e1
left JOIN employees e2
on e1.manager_id = e2.employee_id
WHERE e2.employee_name is NULL;


-- Display employees along with their manager's designation.

-- Employee Name
-- Manager Name
-- Manager Designation


SELECT e1.employee_name as Employee,e2.employee_name as Manager,e2.designation as Manager_designation
FROM employees e1
JOIN employees e2
on e1.manager_id = e2.employee_id;

-- Prepare an employee hierarchy report.



-- Employee Name
-- Employee Designation
-- Manager Name
-- Manager Designation
-- Employee Salary
-- Manager Salary



-- Manager Name
-- Employee Salary (Highest to Lowest)

SELECT e1.employee_name as Employee,e1.designation as Employee_designation,e2.employee_name as Manager,
e2.designation as Manager_designation,e1.salary as Employee_salary,e2.salary as Manager_salary
FROM employees e1
JOIN employees e2
on e1.manager_id = e2.employee_id
ORDER by e2.employee_name, e1.salary desc;</sql><current_tab id="0"/></tab_sql></sqlb_project>
