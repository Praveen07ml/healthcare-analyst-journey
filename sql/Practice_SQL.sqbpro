<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="Practice_SQL.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1507"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="sales" custom_title="0" dock_id="1" table="4,5:mainsales"/><dock_state state="000000ff00000000fd0000000100000002000005f4000002acfc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000005f40000012500ffffff0000026c0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="sales" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="51"/><column index="2" value="85"/><column index="3" value="106"/><column index="4" value="78"/><column index="5" value="96"/><column index="6" value="93"/><column index="7" value="59"/><column index="8" value="70"/><column index="9" value="60"/><column index="10" value="66"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- Display all unique cities.

SELECT DISTINCT city
FROM sales;


-- Display all orders where the city is Hyderabad, Mumbai, or Delhi.

SELECT sale_id,customer_name,city
FROM sales
WHERE city in (&quot;Hyderabad&quot;,&quot;Mumbai&quot;,&quot;Delhi&quot;);


-- Display all orders except those from Hyderabad and Chennai.


SELECT sale_id,customer_name,city
FROM sales
WHERE city not in (&quot;Hyderbad&quot;,&quot;Chennai&quot;);


-- Display products whose unit price is between 5,000 and 20,000.

SELECT product_name,unit_price
FROM sales
WHERE unit_price BETWEEN 5000 and 20000;

-- Display customers whose names start with 'A'.

SELECT customer_name
FROM sales
WHERE customer_name like &quot;A%&quot;;


-- Display all products whose names end with 'r'.

SELECT customer_name
FROM sales
WHERE customer_name like &quot;r%&quot;;


--Display all Laptop orders from Hyderabad.


SELECT customer_name,city,product_name
FROM sales
WHERE product_name = &quot;Laptop&quot; and city = &quot;Hyderabad&quot;;


-- Display all orders where the category is Furniture OR the discount is greater than 3000.

SELECT sale_id,product_name,category,discount
FROM sales
where category = &quot;Furniture&quot; or discount &gt; 3000;



-- Display all records where the discount is NULL.

SELECT sale_id,product_name,discount 
FROM sales
WHERE discount is null;

--Display all orders that satisfy all of the following:

-- City is Hyderabad or Mumbai
-- Unit price is greater than 10,000
-- Discount is NOT NULL

SELECT sale_id,customer_name,city,product_name,unit_price,discount
FROM sales
WHERE city in (&quot;Hyderabad&quot;,&quot;Mumbai&quot;) and unit_price &gt; 10000 and discount is not NULL;

</sql><current_tab id="0"/></tab_sql></sqlb_project>
